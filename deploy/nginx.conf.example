# Salin ke /etc/nginx/sites-available/solvix-landing, ganti domain, lalu:
#   sudo ln -s /etc/nginx/sites-available/solvix-landing /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d topsolvixlabs.my.id -d www.topsolvixlabs.my.id
# Certbot akan menambahkan blok HTTPS dan redirect otomatis.
server {
    listen 80;
    listen [::]:80;
    server_name topsolvixlabs.my.id www.topsolvixlabs.my.id;

    client_max_body_size 5m;

    location / {
        proxy_pass http://127.0.0.1:3200;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
